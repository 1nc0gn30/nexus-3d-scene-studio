[Desktop Entry]
Version=1.0
Type=Application
Name=Nexus 3D Scene Studio
GenericName=Procedural 3D Topology & WebGL Workstation
Comment=Mathematical Geometry Engine, Procedural Fractals, SDF Meshing & MCP 3D Workstation
Exec=/usr/local/bin/nexus-3d desktop
Icon=nexus-3d-scene-studio
Terminal=false
Categories=Development;Graphics;3DGraphics;Science;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open Nexus 3D CLI
Exec=x-terminal-emulator -e "/usr/local/bin/nexus-3d --help"

[Desktop Action Web]
Name=Open Web UI (Port 8082)
Exec=/usr/local/bin/nexus-3d web
